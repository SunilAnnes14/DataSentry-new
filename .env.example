# ----------------------------------------------------------------------------
# DataSentry configuration. Copy to .env (git-ignored) and adjust if needed.
# Everything has a working default for local development.
# ----------------------------------------------------------------------------

# Local Hardhat JSON-RPC endpoint used by the backend
DATASENTRY_RPC_URL=http://127.0.0.1:8545
# Endpoint the *browser* uses for independent ethers.js verification
DATASENTRY_PUBLIC_RPC_URL=http://127.0.0.1:8545
DATASENTRY_CHAIN_ID=31337
DATASENTRY_BLOCKCHAIN_ENABLED=true

# Optional: pin a contract address. If empty, the backend uses the Hardhat
# Ignition deployment, or deploys the compiled contract itself.
DATASENTRY_CONTRACT_ADDRESS=

# Optional signing keys (coordinator + 4 hospitals). If left EMPTY the backend
# uses the accounts managed by the local Hardhat node (accounts #0..#4), so no
# key ever has to be written to disk. Never put real-network keys here and
# never expose them to the frontend.
DATASENTRY_COORDINATOR_KEY=
DATASENTRY_CLIENT_KEY_1=
DATASENTRY_CLIENT_KEY_2=
DATASENTRY_CLIENT_KEY_3=
DATASENTRY_CLIENT_KEY_4=

DATASENTRY_SEED=42
DATASENTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) - API base URL
VITE_API_URL=http://127.0.0.1:8000/api
